{
  "name": "jsonplaceholder-mcp",
  "version": "1.0.0",
  "description": "Demo MCP server for JSONPlaceholder API generated by MCPForge",
  "inbound_auth": {
    "type": "none",
    "warning_accepted": true
  },
  "sources": [
    {
      "type": "openapi",
      "id": "jsonplaceholder",
      "base_url": "https://jsonplaceholder.typicode.com",
      "allowed_hosts": ["jsonplaceholder.typicode.com"]
    }
  ],
  "tools": [
    {
      "name": "get_post",
      "description": "Retrieve a single blog post by its unique post ID. Use this when the user asks for details of a specific post.",
      "enabled": true,
      "mode": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "postId": {
            "type": "string",
            "description": "The ID of the post to retrieve (e.g. 1)"
          }
        },
        "required": ["postId"]
      },
      "executor": {
        "type": "http",
        "source_id": "jsonplaceholder",
        "steps": [
          {
            "method": "GET",
            "path": "/posts/{{input.postId}}",
            "timeout_ms": 5000,
            "response_shaping": {
              "pick": ["id", "title", "body"]
            }
          }
        ]
      }
    },
    {
      "name": "list_posts",
      "description": "List up to 5 blog posts, optionally filtered by user ID. Returns post IDs and titles.",
      "enabled": true,
      "mode": "read",
      "pagination": {
        "limit_param": "limit"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "Optional user ID to filter posts by (e.g. 1)"
          }
        }
      },
      "executor": {
        "type": "http",
        "source_id": "jsonplaceholder",
        "steps": [
          {
            "method": "GET",
            "path": "/posts",
            "query": {
              "userId": "{{input.userId}}"
            },
            "timeout_ms": 5000,
            "response_shaping": {
              "pick": ["id", "title"],
              "max_items": 5
            }
          }
        ]
      }
    }
  ]
}
